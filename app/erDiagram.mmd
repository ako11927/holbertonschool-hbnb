%% HBnB ER Diagram

%% USER table
USER {
    CHAR(36) id PK "UUID"
    VARCHAR first_name
    VARCHAR last_name
    VARCHAR email
    VARCHAR password
    BOOLEAN is_admin
}

%% PLACE table
PLACE {
    CHAR(36) id PK
    VARCHAR title
    TEXT description
    DECIMAL price
    FLOAT latitude
    FLOAT longitude
    CHAR(36) owner_id FK
}

%% REVIEW table
REVIEW {
    CHAR(36) id PK
    TEXT text
    INT rating
    CHAR(36) user_id FK
    CHAR(36) place_id FK
}

%% AMENITY table
AMENITY {
    CHAR(36) id PK
    VARCHAR name
}

%% PLACE_AMENITY join table
PLACE_AMENITY {
    CHAR(36) place_id FK
    CHAR(36) amenity_id FK
    PK (place_id, amenity_id)
}

%% Relationships
USER ||--o{ PLACE : "owns"
USER ||--o{ REVIEW : "writes"
PLACE ||--o{ REVIEW : "has"
PLACE ||--o{ PLACE_AMENITY : "includes"
AMENITY ||--o{ PLACE_AMENITY : "available_at"
